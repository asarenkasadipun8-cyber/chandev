            if success and data then
                if data.speed then config.speed = data.speed end
                if data.tpSpeed then config.tpSpeed = data.tpSpeed end
                if data.customSpots then
                    config.customSpots = {}
                    for i, v in pairs(data.customSpots) do
                        config.customSpots[tonumber(i)] = Vector3.new(v.X, v.Y, v.Z)
                    end
                end
                render()
                loadCfgBtn.Text = "Loaded!"
                task.wait(1)
                loadCfgBtn.Text = "Load"
            end
