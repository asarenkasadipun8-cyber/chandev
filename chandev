            delB.TextColor3 = Color3.new(1,1,1)
            delB.Font = Enum.Font.GothamBold
            delB.Parent = row
            Instance.new("UICorner", delB).CornerRadius = UDim.new(0, 4)
            delB.MouseButton1Click:Connect(function()
                table.remove(config.customSpots, index)
                render()
                notify("Dihapus", "Spot manual dihapus")
            end)
        end
    end

    local sKeys = {}
    for k, _ in pairs(config.summitCPs) do table.insert(sKeys, k) end
    table.sort(sKeys)
    for _, i in ipairs(sKeys) do
        local nm = (i == 0 and "Basecamp") or (i == 21 and "Summit") or (i == 22 and "Balik BC") or "CP "..i
        addRow(nm, config.summitCPs[i], false, nil)
    end

    for i, pos in ipairs(config.customSpots) do
        addRow("Spot "..i, pos, true, i)
    end
end

