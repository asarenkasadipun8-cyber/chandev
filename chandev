local function createSidebarTab(name, index)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 45)
    btn.Position = UDim2.new(0, 10, 0, 15 + (index * 50))
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
    btn.Text = "  " .. name
    btn.TextColor3 = Color3.fromRGB(180, 180, 200)
    btn.Font = Enum.Font.GothamBold
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = sidebar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local page = Instance.new("Frame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = content
    tabs[btn] = page
    table.insert(tabBtns, btn) -- Masukin ke list biar gampang dipanggil
    
    btn.MouseEnter:Connect(function()
        if not page.Visible then TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 40, 55)}):Play() end
    end)
    btn.MouseLeave:Connect(function()
        if not page.Visible then TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 28, 38)}):Play() end
    end)
    btn.MouseButton1Click:Connect(function()
        for b, p in pairs(tabs) do
            p.Visible = false
            TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 28, 38), TextColor3 = Color3.fromRGB(180, 180, 200)}):Play()
        end
        page.Visible = true
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 60, 80), TextColor3 = Color3.new(1,1,1)}):Play()
    end)
    return page
end

