        tpB.Font = Enum.Font.GothamBold
        tpB.Parent = row
        Instance.new("UICorner", tpB).CornerRadius = UDim.new(0, 4)
        tpB.MouseButton1Click:Connect(function() 
            tpTo(pos) 
            notify("Teleport", "Berpindah ke " .. name)
        end)
        
        if isCustom then
            local delB = Instance.new("TextButton")
            delB.Size = UDim2.new(0, 40, 1, -10)
            delB.Position = UDim2.new(1, -45, 0, 5)
            delB.BackgroundColor3 = Color3.fromRGB(200, 50, 80)
