-- ============ CONFIG ============
local config = {
    speed = 50,
    flySpeed = 60,
    waitPerCP = 1.0,
    autoSummit = false,
    antiAfk = true,
    checkpoints = {}
}
local CONFIG_FILE = "ChannDev_Config.json"

if isfile and isfile(CONFIG_FILE) then
    local success, data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
    if success and data then
        if data.checkpoints then
            for k, v in pairs(data.checkpoints) do
                config.checkpoints[tonumber(k)] = Vector3.new(v.X, v.Y, v.Z)
            end
        end
        if data.speed then config.speed = data.speed end
    end
end

local function getHRP() return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") end
local function getHum() return LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") end

-- ============ REMOTE ============
local RemoteService = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:FindFirstChild("Remote")
local CheckpointService = RemoteService and RemoteService:FindFirstChild("CheckpointService")
local ResetCheckpoint = CheckpointService and CheckpointService:FindFirstChild("ResetCheckpoint")

local function tpTo(pos)
    local hrp = getHRP()
    if hrp then
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 5, 0))
        if ResetCheckpoint then pcall(function() ResetCheckpoint:InvokeServer() end) end
    end
end

