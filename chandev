-- ============ LOGIC & RENDER ============
local function render()
    -- Render Auto Summit List
    for _, v in ipairs(scroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
    local sKeys = {}
    for k, _ in pairs(config.summitCPs) do table.insert(sKeys, k) end
    table.sort(sKeys)
    for _, i in ipairs(sKeys) do
        local pos = config.summitCPs[i]
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -10, 0, 30)
        row.BackgroundColor3 = Color3.fromRGB(38, 38, 48)
        row.Parent = scroll
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)
        
        local nameTxt = (i == 0 and "Basecamp") or (i == 21 and "Summit") or (i == 22 and "Balik BC") or "CP "..i
        local num = Instance.new("TextLabel")
        num.Size = UDim2.new(1, 0, 1, 0)
        num.Position = UDim2.new(0, 10, 0, 0)
        num.BackgroundTransparency = 1
        num.Text = nameTxt .. "  |  ("..math.floor(pos.X)..", "..math.floor(pos.Y)..", "..math.floor(pos.Z)..")"
