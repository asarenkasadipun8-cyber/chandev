-- Logic Auto Summit Toggle
autoBtn.MouseButton1Click:Connect(function()
    config.autoSummit = not config.autoSummit
    if config.autoSummit then
        autoBtn.Text = "AUTO SUMMIT: ON"
        autoBtn.BackgroundColor3 = Color3.fromRGB(40, 150, 100)
        task.spawn(function()
            while config.autoSummit do
                for i = 0, 22 do
                    if not config.autoSummit then break end
                    if config.summitCPs[i] then
                        tpTo(config.summitCPs[i])
                        local hum = getHum()
                        if hum then hum.WalkSpeed = config.speed end
                        task.wait(config.tpSpeed)
                    end
                end
                if config.autoSummit and config.summitCPs[0] then 
                    tpTo(config.summitCPs[0])
                    print("[AUTO] Balik ke Basecamp, ngulang...")
                end
                task.wait(2)
            end
        end)
    else
        autoBtn.Text = "AUTO SUMMIT: OFF"
        autoBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 80)
    end
end)

