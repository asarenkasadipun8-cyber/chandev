-- Render List
local function render()
    for _, v in ipairs(scroll:GetChildren()) do
        if v:IsA("Frame") then v:Destroy() end
    end
    local keys = {}
    for k, _ in pairs(config.checkpoints) do table.insert(keys, k) end
    table.sort(keys)

    for _, i in ipairs(keys) do
        local pos = config.checkpoints[i]
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -10, 0, 35)
        row.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        row.Parent = scroll
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)
        
        local num = Instance.new("TextLabel")
        num.Size = UDim2.new(0, 40, 1, 0)
        num.BackgroundTransparency = 1
        num.Text = "CP"..i
        num.TextColor3 = Color3.new(1,1,1)
        num.Font = Enum.Font.GothamBold
        num.Parent = row
        
        local coord = Instance.new("TextLabel")
        coord.Size = UDim2.new(0, 200, 1, 0)
        coord.Position = UDim2.new(0, 40, 0, 0)
        coord.BackgroundTransparency = 1
        coord.Text = string.format("(%.0f, %.0f, %.0f)", pos.X, pos.Y, pos.Z)
        coord.TextColor3 = Color3.fromRGB(150, 150, 150)
        coord.Font = Enum.Font.Code
        coord.TextXAlignment = Enum.TextXAlignment.Left
        coord.Parent = row
        
        local tpBtn = Instance.new("TextButton")
        tpBtn.Size = UDim2.new(0, 40, 1, -10)
        tpBtn.Position = UDim2.new(1, -90, 0, 5)
        tpBtn.BackgroundColor3 = Color3.fromRGB(80, 100, 220)
        tpBtn.Text = "TP"
        tpBtn.TextColor3 = Color3.new(1,1,1)
        tpBtn.Parent = row
        Instance.new("UICorner", tpBtn).CornerRadius = UDim.new(0, 4)
        tpBtn.MouseButton1Click:Connect(function() tpTo(pos) end)
        
        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.new(0, 40, 1, -10)
        delBtn.Position = UDim2.new(1, -45, 0, 5)
        delBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 80)
        delBtn.Text = "X"
        delBtn.TextColor3 = Color3.new(1,1,1)
        delBtn.Parent = row
        Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 4)
        delBtn.MouseButton1Click:Connect(function()
            config.checkpoints[i] = nil
            render()
        end)
    end
end

