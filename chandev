        num.Parent = row
    end

    -- Render Custom TP List
    for _, v in ipairs(tpScroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
    local cKeys = {}
    for k, _ in pairs(config.customSpots) do table.insert(cKeys, k) end
    table.sort(cKeys)
    for _, i in ipairs(cKeys) do
        local pos = config.customSpots[i]
